---
// Estadísticas rápidas del hero. El valor final va en el HTML (visible sin JS, para Google
// y para lectores de pantalla); el script solo anima el conteo si el usuario no pide menos movimiento.
interface Stat {
  value: number;
  label: string;
  prefix?: string;
}
interface Props {
  stats: Stat[];
}
const { stats } = Astro.props;
---

<dl class="mt-6 flex justify-center gap-10">
  {
    stats.map(({ value, label, prefix = '' }) => (
      <div class="flex flex-col-reverse text-center">
        <dt class="text-muted mt-1 font-mono text-xs tracking-wide uppercase">{label}</dt>
        <dd class="text-ink text-4xl font-bold tabular-nums" data-prefix={prefix} data-countup={value} >
          {prefix}{value}
        </dd>
      </div>
    ))
  }
</dl>

<script>
  import { CountUp } from 'countup.js';

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduce) {
    document.querySelectorAll<HTMLElement>('[data-countup]').forEach((el) => {
      new CountUp(el, Number(el.dataset.countup), {
        duration: 1.5,
        prefix: el.dataset.prefix ?? '',
        enableScrollSpy: true,
        scrollSpyOnce: true,
      });
    });
  }
</script>
