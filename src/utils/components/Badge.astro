---
import type { BadgeItem } from '../../interfaces/badgeItem.interface'
import Circle from '../icons/Circle.astro'

interface Props {

    badgeItem: BadgeItem
}


const {badgeItem} = Astro.props

const {title  } = badgeItem



---
<p class="border-accent/60 text-accent flex w-fit items-center justify-center gap-2 rounded-2xl border px-4 py-1 font-mono text-xs">
  <Circle />
  {title}
</p>

