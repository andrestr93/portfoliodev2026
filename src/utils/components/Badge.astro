---
import type { BadgeItem } from '../../interfaces/badgeItem.interface'
import Circle from '../icons/Circle.astro'

interface Props {

    badgeItem: BadgeItem
}


const {badgeItem} = Astro.props

const {title  } = badgeItem



---
<div class="border-2 flex items-center justify-center gap-2 border-accent font-mono w-fit px-6  rounded-2xl text-accent text-xs text-center">
    <Circle/>
    <span class="text-accent-emerald" >
        {title}
    </span>

</div>

