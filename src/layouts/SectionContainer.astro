---
interface Props {
  id: string;
  class?: string;
  labelledby?: string;
}
const { class: className = '', id, labelledby = `${id}-title` } = Astro.props;
---

<section id={id} aria-labelledby={labelledby} class={`mx-auto flex w-full flex-col justify-center lg:w-185 ${className}`}>
  <slot />
</section>