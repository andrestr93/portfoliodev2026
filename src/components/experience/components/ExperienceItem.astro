---
import type { ExperienceItemProps as Props } from '../../../types/experience';
import Timeline from './../../time/TimeLine.astro';

const { company, role, startDate, endDate, location, achievements, technologies } = Astro.props.experience;
---

<Timeline title={role} subtitle={[company, location].filter(Boolean).join(' · ')} startDate={startDate} endDate={endDate}>
  <ul class="text-body flex list-disc flex-col gap-2 ps-5 text-sm leading-6">
    {achievements.map((ach) => <li>{ach}</li>)}
  </ul>
  {/* El campo technologies ya existía en el JSON pero no se mostraba */}
  <ul class="mt-4 flex flex-wrap gap-1.5" aria-label="Tecnologías">
    {technologies.map((t) => <li class="pill">{t}</li>)}
  </ul>
</Timeline>