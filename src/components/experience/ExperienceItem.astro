---

import type { ExperienceItemProps as Props } from '../../types/experience';

const { experience, isLast = false } = Astro.props;
const { company, role, startDate, endDate, location, achievements, technologies, } = experience

const fmt = new Intl.DateTimeFormat('es-ES', { month: 'short', year: 'numeric' });
const label = (ym: string) => fmt.format(new Date(`${ym}-01T00:00:00`));

const period = `${label(startDate)} — ${endDate ? label(endDate) : 'Actualidad'}`;




---


   <li class="ms-6">
            <span class="absolute flex items-center justify-center w-6 h-6 bg-brand-softer rounded-full -start-3 ring-8 ring-buffer">
                <svg class="w-3 h-3 text-fg-brand-strong" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 10h16m-8-3V4M7 7V4m10 3V4M5 20h14a1 1 0 0 0 1-1V7a1 1 0 0 0-1-1H5a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1Zm3-7h.01v.01H8V13Zm4 0h.01v.01H12V13Zm4 0h.01v.01H16V13Zm-8 4h.01v.01H8V17Zm4 0h.01v.01H12V17Zm4 0h.01v.01H16V17Z"/></svg>
            </span>
            <time class="bg-neutral-secondary-medium border border-default-medium text-heading text-xs font-medium px-1.5 py-0.5 rounded">{period}</time>
            <h3 class="my-2 text-md font-semibold text-heading">{company}</h3>
            <h3 class="my-2 text-md font-semibold text-heading">{role}</h3>

                <ul class="  flex flex-col gap-2 text-bod p-4 text-body list-disc">


                    {achievements.map((ach) => (
                        <li>
                            <p>{ach}</p>
                        </li>
                    ))}
            
                </ul>
            
        </li>