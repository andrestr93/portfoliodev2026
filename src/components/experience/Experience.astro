---
import type { TimelineProps as Props } from '../../types/experience';
import SectionTitle from '../SectionTitle.astro';
import ExperienceItem from './components/ExperienceItem.astro';

const { experiences, title = 'Dónde he trabajado' } = Astro.props;
---

<SectionTitle id="experience-title" eyebrow="Experiencia profesional" title={title} />
<ol class="border-default relative ms-3 flex flex-col gap-10 border-s">
  {experiences.map((exp) => <ExperienceItem experience={exp} />)}
</ol>




