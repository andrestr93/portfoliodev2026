---
// Punto del timeline compartido por Experiencia y Educación (antes el marcado estaba duplicado).
import { formatPeriod } from '../../utils/format';

interface Props {
  title: string; // rol o titulación → <h3>
  subtitle: string; // empresa/centro y ubicación → <p>
  startDate: string;
  endDate?: string | null;
}
const { title, subtitle, startDate, endDate } = Astro.props;
---

<li class="ms-6">
  <span class="bg-brand-softer ring-buffer absolute -start-3 flex h-6 w-6 items-center justify-center rounded-full ring-8" aria-hidden="true">
    <svg class="text-fg-brand-strong h-3 w-3" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 10h16m-8-3V4M7 7V4m10 3V4M5 20h14a1 1 0 0 0 1-1V7a1 1 0 0 0-1-1H5a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1Z"/></svg>
  </span>
  <time datetime={startDate} class="bg-neutral-secondary-medium border-default-medium text-heading rounded border px-1.5 py-0.5 text-xs font-medium">
    {formatPeriod(startDate, endDate)}
  </time>
  <h3 class="text-heading mt-3 text-base font-semibold">{title}</h3>
  <p class="text-muted mb-3 text-sm">{subtitle}</p>
  <slot />
</li>
