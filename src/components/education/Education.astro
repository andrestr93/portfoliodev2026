---
import type { TimelineProps as Props } from '../../types/education';
import EducationItem from "./components/EducationItem.astro";

const {education} = Astro.props



---
<span class="text-center">educación</span>
<div class="p-5">

    <ol class="relative border-s border-default flex flex-col gap-7">   
         {education.map((ed, i) => (
      <EducationItem education={ed} isLast={i === education.length - 1} />
    ))}
    </ol>
</div>


