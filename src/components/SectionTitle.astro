---
interface Props {
id: string;
eyebrow: string;
title: string;
subtitle?: string;
}
const { id, eyebrow, title, subtitle } = Astro.props;
---
<header class="mb-8 flex flex-col items-center gap-2 text-center">
<p class="eyebrow">{eyebrow}</p>
<h2 id={id}>{title}</h2>
{subtitle && <p class="text-muted text-sm">{subtitle}</p>}
</header>