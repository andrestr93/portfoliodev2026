---
import type { Link } from '../interfaces/link.interface';
import { site } from '../data/site';

const links: Link[] = [
  { label: 'Sobre mí', link: '#about' },
  { label: 'Stack', link: '#stack' },
  { label: 'Proyectos', link: '#projects' },
  { label: 'Experiencia', link: '#experience' },
  { label: 'Educación', link: '#education' },
  { label: 'Contacto', link: '#contact' },
];
---

<header class="border-ink/8 bg-primary/70 fixed inset-x-0 top-0 z-50 border-b backdrop-blur-md">
  <nav aria-label="Principal" class="mx-auto flex h-16 w-full max-w-6xl items-center justify-between gap-6 px-5">
    <a href="#about" class="text-accent font-mono text-sm font-semibold">&lt;/andrés&gt;</a>

    <ul class="hidden gap-7 md:flex">
      {
        links.map((s) => (
          <li>
            <a href={s.link} class="text-muted hover:text-accent text-sm transition-colors">
              {s.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-2">
      <a
        href={site.cv}
        download
        class="bg-accent text-primary hidden rounded-lg px-4 py-2 text-sm font-semibold transition hover:brightness-110 sm:inline-flex"
      >
        Descargar CV
      </a>

      <button
        id="nav-toggle"
        type="button"
        class="group inline-flex h-11 w-11 items-center justify-center text-white md:hidden"
        aria-expanded="false"
        aria-controls="nav-panel"
      >
        <span class="sr-only">Abrir menú</span>
        <svg class="h-5 w-5 group-aria-expanded:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
        <svg class="hidden h-5 w-5 group-aria-expanded:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </div>
  </nav>

  <ul id="nav-panel" class="border-ink/8 hidden border-t px-5 pb-5 md:hidden">
    {
      links.map((s) => (
        <li class="border-ink/8 border-b">
          <a href={s.link} class="text-ink block py-3.5">
            {s.label}
          </a>
        </li>
      ))
    }
    <li class="pt-4 sm:hidden">
      <a href={site.cv} download class="bg-accent text-primary block rounded-lg px-4 py-3 text-center font-semibold">
        Descargar CV
      </a>
    </li>
  </ul>
</header>

<script>
  const boton = document.getElementById('nav-toggle');
  const panel = document.getElementById('nav-panel');

  const cerrar = () => {
    boton?.setAttribute('aria-expanded', 'false');
    panel?.classList.add('hidden');
  };

  boton?.addEventListener('click', () => {
    const abierto = boton.getAttribute('aria-expanded') === 'true';
    boton.setAttribute('aria-expanded', String(!abierto));
    panel?.classList.toggle('hidden', abierto);
  });

  panel?.querySelectorAll('a').forEach((enlace) => enlace.addEventListener('click', cerrar));
  // Escape cierra el menú y devuelve el foco al botón
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && boton?.getAttribute('aria-expanded') === 'true') {
      cerrar();
      boton.focus();
    }
  });
</script>
