---

import Hero from '../components/Hero.astro';
import TechStack from '../components/TechStack.astro';
import Experience from '../components/experience/Experience.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionContainer from '../layouts/SectionContainer.astro';
import Contact from '../components/Contact.astro';
import Education from '../components/education/Education.astro';
import { experiences } from '../utils/dates';
---

<BaseLayout>
	<section class="flex flex-col gap-10" >
		<SectionContainer id="about">
			<Hero/>
		</SectionContainer>
	
		<SectionContainer id="stack">
			<TechStack />
		</SectionContainer>
	
		<SectionContainer id="experience">
			<Experience experiences = {experiences}/>
		</SectionContainer>
		<SectionContainer id="education">
			<Education/>
		</SectionContainer>
		<SectionContainer id="contact">
			<Contact/>
		</SectionContainer>



	</section>

</BaseLayout>

